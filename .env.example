# Copy to .env and edit. Both scripts/_lib.sh and the Python CLIs read it.
# Values already in your environment win over this file.

# --- where things live ---------------------------------------------------
# DATA_ROOT holds InsureDial; MODELS_ROOT collects every checkpoint the
# pipeline writes. Point them at scratch storage on a cluster.
DATA_ROOT=./data
MODELS_ROOT=./outputs

# --- HuggingFace ---------------------------------------------------------
# Needed for gated backbones (Llama 3.x, Mistral). Create one at
# https://huggingface.co/settings/tokens with read access.
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# --- devices -------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
TOKENIZERS_PARALLELISM=false

# --- logging -------------------------------------------------------------
# report_to is set per config; these only matter if you switch it to wandb.
WANDB_MODE=offline
WANDB_PROJECT=persuarl
